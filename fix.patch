+/* One date bar for the whole page */
+.datebar{display:flex;flex-direction:column;gap:10px}
+.db-top{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:4px 16px}
+.db-now{font-size:13px;font-weight:600;color:var(--ink)}
